{
  "name": "gauntlet",
  "version": "0.1.0",
  "description": "Gauntlet monorepo -- @gauntlet/core (framework-agnostic pipeline), @gauntlet/cli (local-first CLI), apps/web (public Pre-auth Report UI, Build Order #3).",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace=@gauntlet/cli",
    "verify-tls": "node scripts/verify-tls.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^8.57.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.23.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
