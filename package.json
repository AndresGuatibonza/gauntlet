{
  "name": "gauntlet",
  "version": "0.1.0",
  "description": "Gauntlet - Product Scientist & Fast-Value Loop. Build Order #1: Public URL Ingestion Engine.",
  "type": "module",
  "private": true,
  "bin": {
    "gauntlet": "./dist/cli/index.cjs"
  },
  "scripts": {
    "build": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --outfile=dist/cli/index.cjs --external:better-sqlite3 --external:@anthropic-ai/sdk",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
