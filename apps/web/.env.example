# Supabase Postgres, transaction-mode pooler (port 6543) -- required for
# serverless: Dashboard -> Connect -> "Transaction pooler". Never the direct
# connection (port 5432) here; transaction mode is what tolerates many
# short-lived serverless connections without exhausting Postgres' own
# connection limit.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres

# Same key the CLI uses. Get it from console.anthropic.com.
ANTHROPIC_API_KEY=

# Key for hashing visitor IPs in the scan quota (lib/rate-limit.ts). IPs are
# never stored raw. Required -- scans are refused (500) without it. Any long
# random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCAN_IP_HASH_SECRET=

# Optional quota overrides (rolling 24h window). Defaults: 3 per client, 20
# total. Every scan attempt counts, including failed ones.
# SCAN_LIMIT_PER_CLIENT_PER_DAY=3
# SCAN_LIMIT_GLOBAL_PER_DAY=20

# Daily maintenance endpoint (vercel.json cron -> /api/cron/maintenance).
# Vercel Cron sends it as a bearer token. Required in production; at least
# 16 random characters. Without it the endpoint refuses every call.
CRON_SECRET=

# Optional: days to keep anonymous scans and their events (default 180,
# minimum 30). Client IP hashes are always cleared after 48 hours.
# SCAN_RETENTION_DAYS=180

# Optional: database for `npm run migrate` (defaults to DATABASE_URL).
# MIGRATION_DATABASE_URL=
