# Supabase Postgres, transaction-mode pooler (port 6543) -- required for
# serverless: Dashboard -> Connect -> "Transaction pooler". Never the direct
# connection (port 5432) here; transaction mode is what tolerates many
# short-lived serverless connections without exhausting Postgres' own
# connection limit.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres

# Same key the CLI uses. Get it from console.anthropic.com.
ANTHROPIC_API_KEY=

# Key for hashing visitor IPs in the scan quota (lib/rate-limit.ts). IPs are
# never stored raw. Required -- scans are refused (500) without it. Any long
# random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCAN_IP_HASH_SECRET=

# Optional quota overrides (rolling 24h window). Signed-in visitors count per
# account, anonymous ones per client IP. Defaults: 3 per client, 5 per
# account, 20 total. Every scan attempt counts, including failed ones.
# SCAN_LIMIT_PER_CLIENT_PER_DAY=3
# SCAN_LIMIT_PER_ACCOUNT_PER_DAY=5
# SCAN_LIMIT_GLOBAL_PER_DAY=20

# Daily maintenance endpoint (vercel.json cron -> /api/cron/maintenance).
# Vercel Cron sends it as a bearer token. Required in production; at least
# 16 random characters. Without it the endpoint refuses every call.
CRON_SECRET=

# Optional: days to keep anonymous scans and their events (default 180,
# minimum 30). Client IP hashes are always cleared after 48 hours.
# SCAN_RETENTION_DAYS=180

# Optional: database for `npm run migrate` (defaults to DATABASE_URL).
# MIGRATION_DATABASE_URL=

# Optional "Build this" implementation brief limits (rolling 24h; one Claude
# call each, separate from scans). Defaults: 5 per client, 10 per account,
# 40 total.
# PACKAGE_LIMIT_PER_CLIENT_PER_DAY=5
# PACKAGE_LIMIT_PER_ACCOUNT_PER_DAY=10
# PACKAGE_LIMIT_GLOBAL_PER_DAY=40

# Accounts (optional): Supabase Auth with sign-in through GitHub. Both values
# are public (they reach the browser): Supabase -> Project Settings -> API
# Keys -> the project URL and the *publishable* key. Never the secret /
# service-role key. Without them the app runs without accounts.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# GitHub deep scan (optional; needs accounts above): the Gauntlet GitHub App.
# Repository permissions: Contents read-only (Metadata read-only is implied).
# Callback URL: https://<your-app>/api/github/callback (and the localhost one),
# "Request user authorization (OAuth) during installation" on, webhooks off.
# All five are server-only secrets; never prefix them with NEXT_PUBLIC_.
# The private key may be pasted with literal \n instead of newlines.
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=gauntlet-yourname
# GITHUB_APP_CLIENT_ID=Iv23li...
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional repo-aware brief limits per account (rolling 24h; a repository read
# and two or three Claude calls each). Defaults: 10 per account, 60 total.
# REPO_BRIEF_LIMIT_PER_USER_PER_DAY=10
# REPO_BRIEF_LIMIT_GLOBAL_PER_DAY=60
